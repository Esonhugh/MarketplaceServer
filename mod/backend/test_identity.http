@baseUrl = http://localhost:8080
@username = admin
@password = replace-with-bootstrap-password
@jwt = replace-with-login-jwt
@tokenId = 00000000-0000-0000-0000-000000000000
@pat = mpsk_replace-with-personal-access-token
@marketplaceKey = replace-with-marketplace-public-key
@namespace = admin
@plugin = example-plugin
@versionTag = v1.0.0

### Health
GET {{baseUrl}}/api/v1/health
Accept: application/json

### Login
POST {{baseUrl}}/api/v1/auth/login
Accept: application/json
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### List personal access tokens
GET {{baseUrl}}/api/v1/me/tokens?page=1&size=20
Accept: application/json
Authorization: Bearer {{jwt}}

### Create subscription token
POST {{baseUrl}}/api/v1/me/tokens
Accept: application/json
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "name": "http-client-subscription",
  "preset": "sub-read",
  "expiresAt": null
}

### Create Git clone token
POST {{baseUrl}}/api/v1/me/tokens
Accept: application/json
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "name": "http-client-git-clone",
  "preset": "git-clone",
  "expiresAt": null
}

### Create Git write token
POST {{baseUrl}}/api/v1/me/tokens
Accept: application/json
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "name": "http-client-git-write",
  "preset": "git-write",
  "expiresAt": null
}

### Reveal personal access token
POST {{baseUrl}}/api/v1/me/tokens/{{tokenId}}/reveal
Accept: application/json
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "password": "{{password}}"
}

### Revoke personal access token
DELETE {{baseUrl}}/api/v1/me/tokens/{{tokenId}}
Authorization: Bearer {{jwt}}

### List Plugins
GET {{baseUrl}}/api/v1/namespaces/{{namespace}}/plugins?page=1&size=20
Accept: application/json
Authorization: Bearer {{jwt}}

### Create Plugin
POST {{baseUrl}}/api/v1/namespaces/{{namespace}}/plugins
Accept: application/json
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "name": "{{plugin}}",
  "visibility": "public"
}

### Get Plugin
GET {{baseUrl}}/api/v1/namespaces/{{namespace}}/plugins/{{plugin}}
Accept: application/json
Authorization: Bearer {{jwt}}

### Set Plugin private
POST {{baseUrl}}/api/v1/namespaces/{{namespace}}/plugins/{{plugin}}:set-visibility
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "visibility": "private"
}

### Publish existing canonical tag
POST {{baseUrl}}/api/v1/namespaces/{{namespace}}/plugins/{{plugin}}/versions:publish
Accept: application/json
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "tag": "{{versionTag}}",
  "makeDefault": true
}

### List available Plugin versions
GET {{baseUrl}}/api/v1/namespaces/{{namespace}}/plugins/{{plugin}}/versions?page=1&size=20
Accept: application/json
Authorization: Bearer {{jwt}}

### Get exact Plugin version
GET {{baseUrl}}/api/v1/namespaces/{{namespace}}/plugins/{{plugin}}/versions/{{versionTag}}
Accept: application/json
Authorization: Bearer {{jwt}}

### Set default Plugin version
POST {{baseUrl}}/api/v1/namespaces/{{namespace}}/plugins/{{plugin}}/versions/{{versionTag}}:set-default
Authorization: Bearer {{jwt}}

### Clear default Plugin version
DELETE {{baseUrl}}/api/v1/namespaces/{{namespace}}/plugins/{{plugin}}/default-version
Authorization: Bearer {{jwt}}

### Archive Plugin
POST {{baseUrl}}/api/v1/namespaces/{{namespace}}/plugins/{{plugin}}:archive
Authorization: Bearer {{jwt}}

### Restore Plugin
POST {{baseUrl}}/api/v1/namespaces/{{namespace}}/plugins/{{plugin}}:restore
Authorization: Bearer {{jwt}}

### Read authenticated user Marketplace
GET {{baseUrl}}/distribution/users/{{username}}/marketplace.json
Accept: application/json
Authorization: Basic {{username}} {{pat}}

### Read public Marketplace JSON
GET {{baseUrl}}/distribution/marketplaces/{{marketplaceKey}}/marketplace.json
Accept: application/json
